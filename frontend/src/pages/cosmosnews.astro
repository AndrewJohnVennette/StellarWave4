---
import Layout from '../layouts/Layout.astro';

// 1. Fetch or define your data inside the Astro frontmatter (Server-side)
const usersData = {
  people: [
    { name: "Alex", age: 28, job: "Developer" },
    { name: "Elena", age: 34, job: "Designer" }
  ]
};

// 2. Convert the object into a JSON string so it can be passed to the attribute
const jsonString = JSON.stringify(usersData);

const Name = "Stellarwaves-5";
---

<Layout title={Name}>
    <h1> Hello </h1>

    <gev-showitems data-json={jsonString}></gev-showitems>
    
</Layout>

<style>
    body {
        display: grid;
        place-items: center;
        position: relative;
        min-height: 100vh;
    }

    body::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: center / 100% 100% no-repeat
            url(../assets/images/background/new/msh1552.webp);
        /* opacity: 0.45; */
        z-index: -1;
    }

    main {
        height: auto;
        margin: 15rem 0 45vh 0;
    }
</style>
<script>
  // Assuming your web component file is located at /src/scripts/show-data.js
  import "../web-components/GEV-showItems.js";
</script>