---

---
<section class="container">
    <div class="card front-face">
        <header>
            <span class="logo">
                <img src="images/logo.png" alt="" />
                <h5>Master Card</h5>
            </span>
            <img src="images/chip.png" alt="" class="chip" />
        </header>

        <div class="card-details">
            <div class="name-number">
                <h6>Card Number</h6>
                <input id="cardNumber" class="number" type="text" placeholder="8050 2030 3020 5040">
                <h6>Card Holder Name</h6>
                <input id="cardName" class="name" type="text" placeholder="Prem Kumar Shahi">
            </div>

            <div class="valid-date">
                <h6>Valid Thru</h6>
                <input id="expDate" type="text" placeholder="05/28">
            </div>
        </div>
    </div>

    <div class="card back-face">
        <h6>
            For customer service call +977 4343 3433 or email at
            mastercard@gmail.com
        </h6>
        <span class="magnetic-strip"></span>
        <div class="signature"><input id="CVC" type="text" placeholder="005"></div>
        <h5>
            Lorem ipsum dolor sit amet, consectetur adipisicing elit. Officia
            maiores sed doloremque nesciunt neque beatae voluptatibus doloribus.
            Libero et quis magni magnam nihil temporibus? Facere consectetur
            dolore reiciendis et veniam.
        </h5>
    </div>
</section>



<style>
.container {
    color: #fff;
    position: relative;
    height: 225px;
    width: 375px;
    z-index: 100;
    transition: 0.6s;
    transform-style: preserve-3d;
    &.card {
        position: absolute;
        height: 100%;
        width: 100%;
        padding: 25px;
        border-radius: 25px;
        backdrop-filter: blur(25px);
        background: rgba(255, 255, 255, 0.1);
        box-shadow: 0 25px 45px rgba(0, 0, 0, 0.25);
        border: 1px solid rgba(255, 255, 255, 0.1);
        backface-visibility: hidden; /* Ensure backface-visibility is set */
        transform-style: preserve-3d;
    }
  }
  
  .container:hover {
    transform: rotateY(180deg);
  }
  .flipped{
    transform: rotateY(180deg);
  }
  .container .card {
    position: absolute;
    height: 100%;
    width: 100%;
    padding: 25px;
    border-radius: 25px;
    backdrop-filter: blur(25px);
    background: rgba(255, 255, 255, 0.1);
    box-shadow: 0 25px 45px rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backface-visibility: hidden; /* Ensure backface-visibility is set */
    transform-style: preserve-3d;
  }
  
  .front-face {
    backface-visibility: hidden;
    &.logo {
        display: flex;
        align-items: center;
    }
    &.card-details {
        display: flex;
        margin-top: 40px;
        align-items: flex-end;
        justify-content: space-between;
    }
  }
  
  .front-face header,
  .front-face .logo {
    display: flex;
    align-items: center;
  }
  
  .front-face header {
    justify-content: space-between;
  }
  
  .front-face .logo img {
    width: 48px;
    margin-right: 10px;
  }
  
  h5 {
    font-size: 16px;
    font-weight: 400;
  }
  
  .front-face .chip {
    width: 50px;
  }
  
  .front-face .card-details {
    display: flex;
    margin-top: 40px;
    align-items: flex-end;
    justify-content: space-between;
  } 
  
  h6 {
    font-size: 10px;
    font-weight: 400;
  }
  
  h5.number {
    font-size: 18px;
    letter-spacing: 1px;
  }
  
  h5.name {
    margin-top: 20px;
  }
  
  .card.back-face {
    border: none;
    padding: 15px 25px 25px 25px;
    transform: rotateY(180deg);
    backface-visibility: hidden; /* Ensure backface-visibility is set */
  }
  
  .card.back-face h6 {
    font-size: 8px;
  }
  
  .card.back-face .magnetic-strip {
    position: absolute;
    top: 40px;
    left: 0;
    height: 45px;
    width: 100%;
    background: #000;
  }
  
  .card.back-face .signature {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin-top: 80px;
    height: 40px;
    width: 85%;
    border-radius: 6px;
    background: repeating-linear-gradient(#fff,
        #fff 3px,
        #efefef 0px,
        #efefef 9px);
  }
  
  .signature i {
    color: #000;
    font-size: 12px;
    padding: 4px 6px;
    border-radius: 4px;
    background-color: #fff;
    margin-right: -30px;
    z-index: -1;
  }
  
  .card.back-face h5 {
    font-size: 8px;
    margin-top: 15px;
  }
  
/* Existing styles... */

/* New styles for input elements */
input {
    background: transparent;
    border: none;
    color: #fff;
    font-family: "Poppins", sans-serif;
    font-size: 16px;
    width: 100%;
    padding: 0;
  }
  
  input:focus {
    outline: none;
    border: 1px solid red;
  }
  
  /* Specific styles for card number */
  .number {
    font-size: 27px;
    letter-spacing: 1px;
  }
  
  /* Specific styles for card name */
  .name {
    margin-top: 20px;
  }
  
  /* Styling for CVC on back-face */
  .back-face .signature input {
    color: #000;
    font-size: 12px;
    padding: 4px 6px;
    border-radius: 4px;
    background-color: #fff;
    margin-right: -30px;
    z-index: -1;
    width: 35px;
  }
  #expDate{
    width: 43px;
  }
  
  /* Placeholder text color for inputs */
  ::placeholder {
    color: rgba(255, 255, 255, 0.7);
    opacity: 1; /* Firefox */
  }
  
  /* Adjustments for back-face input */
  .back-face input::placeholder {
    color: #000;
  }
</style>

<script>
// Combined validation for cardNumber
function validateCardNumber(e) {
    let value = e.target.value.replace(/\s/g, '').replace(/(\d{4})/g, '$1 ').trim();
    e.target.value = value.slice(0, 19); // Ensure only 16 digits + 3 spaces

    const cardNumberRegex = /^(?:[0-9]{4}\s){3}[0-9]{4}$/;
    if (!cardNumberRegex.test(e.target.value)) {
        if (e.type === 'blur') { // Only show alert on blur
            alert('Invalid card number format. Please use 16 digits with spaces after every 4 digits.');
        }
        e.target.style.borderBottom = '1px solid red';
    } else {
        e.target.style.borderBottom = ''; // or any other valid state style
    }
    checkFieldsAndFlip();
}

// Attach to cardNumber events
document.getElementById('cardNumber').addEventListener('input', validateCardNumber);
document.getElementById('cardNumber').addEventListener('blur', validateCardNumber);

// Function to check fields and flip the card in sequence
function checkFieldsAndFlip() {
    const cardNumber = document.getElementById('cardNumber').value.trim();
    const cardName = document.getElementById('cardName').value.trim();
    const expDate = document.getElementById('expDate').value.trim();
    const cvc = document.getElementById('CVC').value.trim();
    const container = document.querySelector('.container');

    const cardNumberRegex = /^(?:[0-9]{4}\s){3}[0-9]{4}$/;
    const expDateRegex = /^(0[1-9]|1[0-2])\/([2-9][6-9]|[3-9][0-9])$/;

    // Step 1: Check if front-face fields are filled and valid to flip to back
    const frontFieldsFilled = cardNumber !== '' && cardName !== '' && expDate !== '' &&
                            cardNumberRegex.test(cardNumber) && expDateRegex.test(expDate);

    if (frontFieldsFilled && cvc === '' && !container.classList.contains('flipped')) {
        container.classList.add('flipped'); // Flip to back when front fields are complete
    } 
    // Step 2: Check if CVC is filled to flip back
    else if (frontFieldsFilled && cvc !== '' && cvc.length === 3 && container.classList.contains('flipped')) {
        container.classList.remove('flipped'); // Flip back when CVC is complete
    }
    // If front fields are not all filled and valid, ensure card is not flipped
    else if (!frontFieldsFilled && container.classList.contains('flipped')) {
        container.classList.remove('flipped');
    }
}

// Add event listeners to other fields to check and flip on input
document.getElementById('cardName').addEventListener('input', checkFieldsAndFlip);
document.getElementById('expDate').addEventListener('input', function(e) {
    const value = e.target.value.replace(/\D/g, '').slice(0, 4);
    if (value.length >= 2) {
        e.target.value = value.slice(0, 2) + (value.length > 2 ? '/' : '') + value.slice(2, 4);
    } else {
        e.target.value = value;
    }
    checkFieldsAndFlip();
});
document.getElementById('CVC').addEventListener('input', checkFieldsAndFlip);

// Add blur event for expDate validation
document.getElementById('expDate').addEventListener('blur', function(e) {
    const expDateRegex = /^(0[1-9]|1[0-2])\/([2-9][6-9]|[3-9][0-9])$/;
    if (!expDateRegex.test(e.target.value)) {
        alert('Invalid expiration date. Please use MM/YY format with MM from 01 to 12 and YY greater than 25.');
        e.target.style.borderBottom = '1px solid red';
    } else {
        e.target.style.borderBottom = '';
    }
    checkFieldsAndFlip();
});

// Prevent flipping on input click
document.querySelector('.container').addEventListener('click', function(e) {
    if (e.target.tagName !== 'INPUT') {
        // Logic here is now handled by checkFieldsAndFlip, so this can be optional
    }
});

</script>