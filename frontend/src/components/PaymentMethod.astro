---

<section class="completeCard">
        <section class="servicePage">
            <article class="card" id="card-payment">
                <label>Payment Info</label>

                <!-- Card Number -->
                <section class="inputBoxData">
                    <input
                        type="text"
                        id="cardNumber"
                        required
                        maxlength="19"
                        autocomplete="cc-number"
                        inputmode="numeric"
                        placeholder=""
                    >
                    <label for="cardNumber">Card Number Required — 16 digits</label>
                </section>

                <!-- Cardholder Name -->
                <section class="inputBoxData">
                    <input
                        type="text"
                        id="cardName"
                        required
                        autocomplete="cc-name"
                        placeholder=""
                    >
                    <label for="cardName">Cardholder Name Required</label>
                </section>

                <!-- Expiry Date -->
                <section class="inputBoxData">
                    <input
                        type="text"
                        id="expDate"
                        required
                        maxlength="5"
                        autocomplete="cc-exp"
                        inputmode="numeric"
                        placeholder=""
                    >
                    <label for="expDate">Expiry Date Required — MM/YY</label>
                </section>

                <!-- CVC -->
                <section class="inputBoxData">
                    <input
                        type="text"
                        id="CVC"
                        required
                        maxlength="4"
                        autocomplete="cc-csc"
                        inputmode="numeric"
                        placeholder=""
                    >
                    <label for="CVC">CVC Required — 3 or 4 digits</label>
                    <!-- <span class="field-hint">* </span> -->
                </section>
            </article>
        </section>
</section><!-- /.completeCard -->


<style>
/* ═══════════════════════════════════════════════════════════════════
   PaymentMethod — card styled identically to UserBlock
   ═══════════════════════════════════════════════════════════════════ */

/* ── Card shell ─────────────────────────────────── */
#card-payment {
    position: relative;
    border: var(--border-w) solid var(--border);
    border-radius: var(--radius);
    padding: 2.6rem 2.2rem 2rem;
    background: var(--surface);
    margin: 1.8rem auto;
    width: 45vw;
    box-shadow:
        0 0 0 1px rgba(255,255,255,.04) inset,
        0 8px 40px rgba(0,0,0,.55);

    /* ── Floating label badge (matches UserBlock) ── */
    & > label {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translate(-50%, -50%);

        background: var(--label-bg);
        color: var(--accent);
        padding: var(--label-pad-y) var(--label-pad-x);
        border-radius: 30%;

        outline: var(--border-w) solid var(--border);
        outline-offset: 0px;

        font-size: .88rem;
        font-weight: 500;
        letter-spacing: .12em;
        text-transform: uppercase;
        white-space: nowrap;

        animation: pmLabelDrop .6s cubic-bezier(.22,1,.36,1) both;
    }
}

/* ── Input row ──────────────────────────────────── */
.inputBoxData {
    position: relative;
    width: 70%;
    margin: 1.5rem auto;

    /* The actual <input> */
    & input {
        background: transparent;
        width: 100%;
        padding: 19px 0;
        border: solid 1px rgba(255, 255, 255, .25);
        border-radius: 5px;
        outline: none;
        color: #fff;
        font-size: 1rem;
        transition: border-color .5s, box-shadow .5s;
    }

    /* Floating field label — rises when focused or valid */
    & label {
        position: absolute;
        left: 0;
        top: 0;
        padding: 10px;
        pointer-events: none;
        font-size: 1rem;
        color: rgba(255, 255, 255, .25);
        text-transform: uppercase;
        transition: .5s;
    }

    /* Hint text below input */
    & .field-hint {
        display: block;
        margin-top: .3rem;
        color: #ed1207;
        font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande',
                     'Lucida Sans Unicode', Geneva, Verdana, sans-serif;
        font-weight: 700;
        font-size: small;
    }

    /* Raise label when input has content or is focused */
    & input:focus ~ label,
    & input:not(:placeholder-shown) ~ label {
        color: #00dfc4;
        transform: translateX(10px) translateY(-7px);
        font-size: .65rem;
        padding: 0 10px;
        background: #1d2b3a;
        border-left: solid 1px #00dfc4;
        border-right: solid 1px #00dfc4;
        letter-spacing: .2rem;
    }

    /* Teal border while focused or valid */
    & input:focus,
    & input:not(:placeholder-shown) {
        border: solid 1px #00dfc4;
    }

    /* Red border on invalid (only after the user has interacted) */
    & input.is-invalid {
        border-color: #e53535;
        box-shadow: 0 0 0 2px rgba(229,53,53,.18);
    }

    /* Green border when field passes validation */
    & input.is-valid {
        border-color: #00dfc4;
        box-shadow: 0 0 0 2px rgba(0,223,196,.12);
    }
}

/* ── Entry animation ────────────────────────────── */
@keyframes pmLabelDrop {
    from { opacity: 0; transform: translate(-50%, -70%); }
    to   { opacity: 1; transform: translate(-50%, -50%); }
}

/* ── Media queries ──────────────────────────────── */
@media screen and (max-width: 400px) {
    #card-payment {
        padding: var(--servicePaddingMobileLess400);
        margin:  var(--serviceMarginMobileLess400);
        width:   var(--serviceWidthMobileLess400);
    }
    .inputBoxData {
        width: 70vw;
        margin: 1.5rem auto;
    }
}

@media screen and (min-width: 800px) and (max-width: 1028px) { }
@media screen and (min-width: 1028.01px) { }
</style>


<script>
// ═══════════════════════════════════════════════════════════════════════════
// PaymentMethod.astro — field validation & card-flip
//
// Elements that actually exist in the DOM (IDs match the HTML above):
//   #cardNumber  — 16-digit card number, auto-formatted as "XXXX XXXX XXXX XXXX"
//   #cardName    — cardholder full name
//   #expDate     — expiry, auto-formatted as MM/YY
//   #CVC         — 3-4 digit security code
//
// Behaviour:
//   • cardNumber auto-inserts spaces every 4 digits as the user types.
//   • expDate auto-inserts "/" after the month digits.
//   • Each field gets .is-valid / .is-invalid after the user first blurs it.
//   • When the three front-face fields (cardNumber, cardName, expDate) are all
//     valid the card flips to show the back so the user can enter the CVC.
//   • When CVC reaches 3+ digits the card flips back to the front face.
//   • The "blink" highlight walks through the first incomplete field so the
//     user always knows what to fill in next.
// ═══════════════════════════════════════════════════════════════════════════

// ── Element refs (all IDs exist in the HTML above) ───────────────────────
const elNumber  = document.getElementById('cardNumber');
const elName    = document.getElementById('cardName');
const elExp     = document.getElementById('expDate');
const elCVC     = document.getElementById('CVC');
const cardWrap  = document.querySelector('.completeCard');

// ── Regex validators ─────────────────────────────────────────────────────
const RX_NUMBER = /^(?:\d{4} ){3}\d{4}$/;                   // "XXXX XXXX XXXX XXXX"
const RX_EXP    = /^(0[1-9]|1[0-2])\/(\d{2})$/;             // MM/YY, month 01-12
const RX_NAME   = /\S/;                                       // at least one non-space char
const RX_CVC    = /^\d{3,4}$/;

// ── Touched flags (show errors only after first blur per field) ───────────
const touched = { cardNumber: false, cardName: false, expDate: false, CVC: false };

// ── Validators ───────────────────────────────────────────────────────────
function isNumberValid()  { return RX_NUMBER.test(elNumber.value); }
function isNameValid()    { return RX_NAME.test(elName.value.trim()); }
function isExpValid()     { return RX_EXP.test(elExp.value); }
function isCVCValid()     { return RX_CVC.test(elCVC.value.trim()); }
function isFrontValid()   { return isNumberValid() && isNameValid() && isExpValid(); }

// ── Apply .is-valid / .is-invalid to an input ────────────────────────────
function markField(el, valid) {
    el.classList.toggle('is-valid',   valid);
    el.classList.toggle('is-invalid', !valid);
}

// ── Blink: highlight the first incomplete field ───────────────────────────
function updateBlink() {
    [elNumber, elName, elExp, elCVC].forEach(el => el.classList.remove('blink'));

    if      (!isNumberValid()) elNumber.classList.add('blink');
    else if (!isNameValid())   elName.classList.add('blink');
    else if (!isExpValid())    elExp.classList.add('blink');
    else if (!isCVCValid())    elCVC.classList.add('blink');
    // All complete → nothing blinks
}

// ── Card-flip logic ───────────────────────────────────────────────────────
function updateFlip() {
    if (!cardWrap) return;
    const flipped = cardWrap.classList.contains('flipped');

    if (isFrontValid() && !isCVCValid() && !flipped) {
        cardWrap.classList.add('flipped');      // show back to enter CVC
    } else if (isCVCValid() && flipped) {
        cardWrap.classList.remove('flipped');   // flip back when CVC done
    } else if (!isFrontValid() && flipped) {
        cardWrap.classList.remove('flipped');   // un-flip if front becomes invalid
    }
}

// ── Combined update called after every event ─────────────────────────────
function onUpdate() {
    updateBlink();
    updateFlip();
}

// ── cardNumber: auto-format XXXX XXXX XXXX XXXX ──────────────────────────
elNumber.addEventListener('input', () => {
    const digits = elNumber.value.replace(/\D/g, '').slice(0, 16);
    elNumber.value = digits.match(/.{1,4}/g)?.join(' ') ?? digits;
    if (touched.cardNumber) markField(elNumber, isNumberValid());
    onUpdate();
});

elNumber.addEventListener('blur', () => {
    touched.cardNumber = true;
    markField(elNumber, isNumberValid());
    onUpdate();
});

// ── cardName ──────────────────────────────────────────────────────────────
elName.addEventListener('input', () => {
    if (touched.cardName) markField(elName, isNameValid());
    onUpdate();
});

elName.addEventListener('blur', () => {
    touched.cardName = true;
    markField(elName, isNameValid());
    onUpdate();
});

// ── expDate: auto-format MM/YY ────────────────────────────────────────────
elExp.addEventListener('input', () => {
    const digits = elExp.value.replace(/\D/g, '').slice(0, 4);
    elExp.value = digits.length > 2
        ? digits.slice(0, 2) + '/' + digits.slice(2)
        : digits;
    if (touched.expDate) markField(elExp, isExpValid());
    onUpdate();
});

elExp.addEventListener('blur', () => {
    touched.expDate = true;
    markField(elExp, isExpValid());
    onUpdate();
});

// ── CVC ───────────────────────────────────────────────────────────────────
elCVC.addEventListener('input', () => {
    elCVC.value = elCVC.value.replace(/\D/g, '').slice(0, 4);
    if (touched.CVC) markField(elCVC, isCVCValid());
    onUpdate();
});

elCVC.addEventListener('blur', () => {
    touched.CVC = true;
    markField(elCVC, isCVCValid());
    onUpdate();
});

// ── Kick off blink on page load ───────────────────────────────────────────
document.addEventListener('DOMContentLoaded', updateBlink);
</script>