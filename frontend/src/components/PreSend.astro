---
const { paymente = "/payment"} = Astro.props;
---
<section class="servicePage">
    <h2>Some text some text some text</h2>
    <article class="card unlocked" id="check-list">
        <label>Check List</label>
        <section class="inputBoxData">
            <a href={paymente} class="proceed-to-payment" id="proceed-to-payment">
                <span id="lng-selectedOp-Payment">
                    Proceed <br> to <br> Payment 
                </span>
            </a>
        </section>
    </article>
</section>
<style>
    #check-list{
        display: grid;
        align-items: center;
        justify-content: center;

        position: relative;
        border: var(--border-w) solid var(--border);
        border-radius: var(--radius);
        padding: 2.6rem 2.2rem 2rem;
        background: var(--surface);
        margin: 1.8rem auto;
        width: 45vw;
        box-shadow: 0 0 0 1px rgba(255,255,255,.04) inset,0 8px 40px rgba(0,0,0,.55);
    
        & .inputBoxData{
            display: grid;
            place-items: center;
            min-height: 10vh;
            & span{
                font-size: 1.1rem;
                text-shadow: 1px 1px 1px rgba(0,0,0,.55);
                text-align: center;
            }
        }
        & .proceed-to-payment{
            padding: 1.7vh 3vw;
            border: solid 3px var(--boxBorder);
            border-radius: 1.3rem;
            background-color: var(--letterColor01);
            color:rgba(255, 255, 255, .7);
            font-size: clamp(1.1rem, var(--basicFontSize) * 3, 1.5rem);
            font-family: var(--basicFontFamily);
        }
    }

    /* ------------------- Media Query section  -------------------*/
/* 1. Mobile under 400vw */
@media screen and (max-width: 400px) {
    #check-list{
        padding: var(--servicePaddingMobileLess400);
        margin: var(--serviceMarginMobileLess400);
        width: var(--serviceWidthMobileLess400);
    }
    input[type="checkbox"]{
        height: 20px;
        &::before{
            height: 20px;
        }
    }
}

/* 2. Tables between 800px and 1028px (inclusive) */
@media screen and (min-width: 800px) and (max-width: 1028px) {
    /* Your tablet/mid-size styles here */
}

/* 3. Everything above 1028px */
@media screen and (min-width: 1028.01px) { 
    /* Your desktop/large screen styles here */
}
</style>

<!-- No script needed: the locked/unlocked state is fully controlled
     by the .block-locked class applied by services.astro's orchestrator.
     When the section is locked, pointer-events:none prevents clicking the
     payment link. When unlocked, it is fully interactive. -->